# Copy to .env.local and fill in values

# URL of the Go api-gateway (rewrites /api/* to this origin)
NEXT_PUBLIC_API_URL=http://localhost:8080

# AWS Cognito (for production auth)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_DOMAIN=your-app.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/api/auth/callback
