# ============================================================
# AutoDreamApplier — Terraform Variables
# Copy to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars to git (it's in .gitignore).
# ============================================================

aws_region   = "us-east-1"
project_name = "autodream"

# ── Environment ──────────────────────────────────────────────────────────────
# "staging"    → dev JWT (HS256) auth, /auth/login and /auth/register routes enabled
# "production" → Cognito RS256 auth only, dev routes hidden
app_env = "staging"

# ── Database (Neon.tech free tier) ───────────────────────────────────────────
# Sign up at https://neon.tech → create project "autodream" → copy connection string
database_url = "postgresql://user:pass@host/db?sslmode=require"

# ── Redis (Upstash free tier) ─────────────────────────────────────────────────
# Sign up at https://upstash.com → create Redis "autodream" → copy connection string
redis_url = "rediss://default:pass@host:6379"

# ── Secrets — generate with: openssl rand -hex 32 ────────────────────────────
jwt_secret     = ""   # min 32 chars — used for HS256 dev tokens
dev_jwt_secret = ""   # set to same value as jwt_secret
encryption_key = ""   # 32-byte hex for AES-256-GCM credential encryption

# ── AI / LLM ─────────────────────────────────────────────────────────────────
gemini_api_key = ""   # https://aistudio.google.com/app/apikey
ai_provider    = "gemini"
llm_model      = "gemini-1.5-flash"

# Anthropic (optional, swap in when ai_provider=anthropic)
# anthropic_api_key = ""
# llm_model         = "claude-3-haiku-20240307"

# ── Cognito (only needed when app_env=production) ─────────────────────────────
# Option A: Let Terraform create a new pool → set create_cognito=true in cognito.tf
# Option B: Use existing pool → fill in the IDs below
cognito_user_pool_id  = ""
cognito_app_client_id = ""
cognito_domain        = ""

# ── Notifications ─────────────────────────────────────────────────────────────
# Verify your sender domain at https://console.aws.amazon.com/ses first
ses_from_email = ""   # e.g. "noreply@yourdomain.com"
dashboard_url  = "https://autodreamapplier.vercel.app"

# ── EC2 (browser pool) ───────────────────────────────────────────────────────
# SSH key is auto-generated by Terraform and stored in AWS Secrets Manager.
# Retrieve it after apply: see setup_commands output.
admin_ssh_cidr = "YOUR_IP/32"   # find your IP: curl ifconfig.me

# ── S3 buckets — names must be globally unique ───────────────────────────────
s3_bucket_resumes     = "autodream-resumes-prod"
s3_bucket_screenshots = "autodream-screenshots-prod"

# ── LinkedIn scraper (optional) ──────────────────────────────────────────────
linkedin_proxy_url = ""   # residential proxy required; leave empty to disable
