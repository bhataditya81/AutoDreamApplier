# ============================================================
# AutoDreamApplier — Terraform Variables
# Copy to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars to git (it's in .gitignore).
# ============================================================

aws_region   = "us-east-1"
project_name = "autodreamApplier"

# ── Environment ──────────────────────────────────────────────────────────────
# "staging"    → dev JWT (HS256) auth, /auth/login and /auth/register routes enabled
# "production" → Cognito RS256 auth only, dev routes hidden
app_env = "staging"

# ── Database (Neon.tech free tier) ───────────────────────────────────────────
# 1. Sign up at https://neon.tech
# 2. Create project "autodream", copy the connection string from the dashboard
# 3. Run migrations: migrate -path ./migrations -database "$DATABASE_URL" up
database_url = "postgresql://neondb_owner:npg_WrNAatPe7U6u@ep-noisy-wave-am6vdr32-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── Redis (Upstash free tier) ─────────────────────────────────────────────────
# 1. Sign up at https://upstash.com
# 2. Create Redis database "autodream", copy the connection string
redis_url = "rediss://default:gQAAAAAAAUiEAAIncDFkMWMyZjM2NzZjMzE0N2VjOWJlYmMzNzc5M2VlMzNiZXAxODQxMDA@driving-ewe-84100.upstash.io:6379"

# ── Secrets — generate with: openssl rand -hex 32 ────────────────────────────
jwt_secret     = ""   # min 32 chars — used for HS256 dev tokens
dev_jwt_secret = ""   # set to the same value as jwt_secret
encryption_key = ""   # 32-byte hex for AES-256-GCM credential encryption

# ── AWS credentials (for Lambda to call S3 + SES) ────────────────────────────
# Use an IAM user with least-privilege S3/SES access
# OR leave empty if Lambda uses the EC2 instance profile via IMDS
aws_access_key_id     = ""
aws_secret_access_key = ""

# ── Cognito (only needed when app_env=production) ─────────────────────────────
# Option A: Let Terraform create a new pool → set create_cognito=true in cognito.tf
# Option B: Use existing pool → fill these in
cognito_user_pool_id  = ""  # e.g. "us-east-1_XXXXXXXXX"
cognito_app_client_id = ""
cognito_domain        = ""

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Get from https://console.anthropic.com
anthropic_api_key = ""
ai_provider       = "anthropic"
llm_model         = "claude-3-haiku-20240307"
ai_service_url    = ""  # Update after EC2 Elastic IP is assigned (e.g. "http://1.2.3.4:8000")

# ── Notifications ─────────────────────────────────────────────────────────────
# SES: verify your sender domain at https://console.aws.amazon.com/ses
ses_from_email = "noreply@yourdomain.com"
dashboard_url  = "https://autodreamapplier.vercel.app"

# ── EC2 (browser pool) ───────────────────────────────────────────────────────
# Create key pair first: AWS Console → EC2 → Key Pairs → Create
ec2_key_pair_name = "autodream-ec2"
admin_ssh_cidr    = "YOUR_IP/32"  # find your IP: curl ifconfig.me

# After first terraform apply, get Elastic IP from output and update:
browser_pool_url = ""  # e.g. "http://1.2.3.4:9222"

# ── S3 buckets — names must be globally unique ───────────────────────────────
# Add a suffix (e.g. your AWS account ID) if defaults are taken
s3_bucket_resumes     = "autodream-resumes-prod"
s3_bucket_screenshots = "autodream-screenshots-prod"

# ── LinkedIn scraper (optional) ──────────────────────────────────────────────
linkedin_proxy_url = ""  # residential proxy required; leave empty to disable
