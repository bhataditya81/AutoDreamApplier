# ===========================================
# AutoDreamApplier - Environment Configuration
# ===========================================
# Copy this file to .env and fill in values

# Application
APP_ENV=development
APP_PORT=8080
APP_LOG_LEVEL=debug

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=autodream
DB_PASSWORD=autodream_dev
DB_NAME=autodreamapplier
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AWS (local dev uses localstack or minio)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS Cognito
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_DOMAIN=

# AWS S3
S3_BUCKET_RESUMES=autodream-resumes-dev
S3_BUCKET_SCREENSHOTS=autodream-screenshots-dev
S3_ENDPOINT=http://localhost:9000

# AWS SES
SES_FROM_EMAIL=noreply@autodreamapplier.com
DASHBOARD_URL=http://localhost:3000

# AWS KMS
KMS_KEY_ID=

# AI Service
AI_SERVICE_URL=http://localhost:8081

# AI Provider selection: "python" (default), "anthropic", "gemini", "openai"
AI_PROVIDER=python

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-haiku-20240307

# Google Gemini (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Browser Pool
BROWSER_POOL_SIZE=3
BROWSER_POOL_URL=http://localhost:8082

# Proxy
PROXY_PROVIDER=brightdata
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=

# 2Captcha
CAPTCHA_API_KEY=

# Rate Limiting
RATE_LIMIT_INDEED=10
RATE_LIMIT_GLASSDOOR=8
RATE_LIMIT_LINKEDIN=3
